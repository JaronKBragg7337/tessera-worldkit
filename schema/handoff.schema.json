{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tessera.dev/schema/handoff.schema.json",
  "title": "tessera.handoff/1",
  "description": "Capability manifest for a portable Tessera AI handoff.",
  "type": "object",
  "required": [
    "schema",
    "target",
    "prompt",
    "catalog",
    "asset_count",
    "assets",
    "environment",
    "contains_layout",
    "rules"
  ],
  "properties": {
    "schema": { "const": "tessera.handoff/1" },
    "target": {
      "enum": ["chat", "browser", "sandbox", "desktop"]
    },
    "prompt": { "type": "string" },
    "catalog": {
      "type": "object",
      "required": ["kit", "fingerprint", "contract_version"],
      "properties": {
        "kit": { "type": "string" },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "contract_version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "asset_count": { "type": "integer", "minimum": 1 },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "environment": {
      "type": "object",
      "required": ["can_execute", "can_validate", "delivery"]
    },
    "contains_layout": { "type": "boolean" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
